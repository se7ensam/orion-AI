# Orion Ingestion Worker - Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# RabbitMQ connection string
RABBITMQ_URL=amqp://localhost:5672

# PostgreSQL connection string
DATABASE_URL=postgres://orion:orion_password@localhost:5432/orion

# User-Agent for SEC.gov API (REQUIRED - must include contact info)
# SEC.gov requires identification: https://www.sec.gov/os/accessing-edgar-data
USER_AGENT=YourCompany/1.0 (your-email@example.com)

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Environment (development, production)
NODE_ENV=development

# SEC API base URL (default: https://www.sec.gov/Archives)
SEC_API_BASE=https://www.sec.gov/Archives

# ============================================
# PERFORMANCE TUNING
# ============================================

# Worker concurrency - number of messages to process simultaneously
# Default: 1 (safe for SEC rate limits)
# WARNING: Values > 2 may trigger rate limiting without distributed throttling
WORKER_CONCURRENCY=1

# Database connection pool size
# Default: 20
# Adjust based on: (number of workers) × (pool size) < database max_connections
DB_POOL_SIZE=20

# Metrics reporting interval in milliseconds
# Default: 300000 (5 minutes)
# Set to 60000 for 1 minute, 600000 for 10 minutes
METRICS_INTERVAL_MS=300000

# ============================================
# LOGGING
# ============================================

# Log level (DEBUG, INFO, WARN, ERROR)
# Default: INFO
# Use DEBUG for troubleshooting, ERROR for minimal logging
LOG_LEVEL=INFO

# ============================================
# NOTES
# ============================================

# Performance Tuning Guidelines:
# 
# For low volume (<100 jobs/hour):
#   WORKER_CONCURRENCY=1
#   DB_POOL_SIZE=5
#
# For medium volume (100-1000 jobs/hour):
#   WORKER_CONCURRENCY=1
#   DB_POOL_SIZE=10
#
# For high volume (>1000 jobs/hour):
#   WORKER_CONCURRENCY=2
#   DB_POOL_SIZE=20
#   Consider: Multiple worker instances with distributed rate limiting
#
# SEC Rate Limits:
#   - 10 requests/second maximum
#   - Worker uses 8 req/sec (conservative)
#   - WORKER_CONCURRENCY > 2 requires distributed rate limiting
